# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/qsm"
UPLOAD_DIR="./storage/uploads"
# Random secret used to hash visitor IPs for rate limiting (any long random string).
IP_HASH_SALT="change-me"
# SMTP connection for enquiry emails, e.g. smtps://user:app-password@smtp.gmail.com:465
SMTP_URL=""
# Who receives enquiry notifications (comma-separated).
LEAD_NOTIFY_TO="sales@example.com"
MAIL_FROM="Quality Steel and Metals <no-reply@example.com>"
